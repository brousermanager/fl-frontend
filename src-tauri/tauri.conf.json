{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Radio Frequenza Libera",
  "version": "0.1.0",
  "identifier": "com.radiofrekuenzalibera.app",
  "build": {
    "beforeDevCommand": "TAURI_PLATFORM=1 npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "TAURI_PLATFORM=1 npm run generate",
    "frontendDist": "../.output/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Radio Frequenza Libera",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "os": {
      "platforms": ["desktop", "android", "ios"]
    },
    "haptics": {
      "platforms": ["android", "ios"]
    },
    "barcode-scanner": {
      "platforms": ["android", "ios"]
    },
    "biometric": {
      "platforms": ["android", "ios"]
    },
    "nfc": {
      "platforms": ["android"]
    }
  }
}
